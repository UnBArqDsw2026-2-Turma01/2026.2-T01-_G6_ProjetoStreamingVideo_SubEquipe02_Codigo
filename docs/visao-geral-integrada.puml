@startuml visao-geral-integrada
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 32
skinparam ranksep 40
skinparam packageFontSize 12
skinparam ArrowFontSize 9
skinparam NoteBackgroundColor #FFFDE7
skinparam packageBorderThickness 1.5
top to bottom direction
hide empty members

title Visão geral integrada — domínio, recarga, doação e chat

package "1. Domínio" as DOM #F3E8FC {
  abstract class Transacao
  class Recarga
  class Doacao
  class DoacaoComMensagem
  class Saque
  class Usuario
  class Carteira
  class Dinheiro <<value object>>

  class Chat <<Client>>
  class FaixaDestaque
  interface PropriedadesFaixa

  Transacao <|-- Recarga
  Transacao <|-- Doacao
  Transacao <|-- Saque
  Doacao <|-- DoacaoComMensagem
  Transacao --> Usuario
  Usuario *-- Carteira

  Transacao -[hidden]right- Chat
  Chat ..> FaixaDestaque : <<consulta>>
  FaixaDestaque ..> PropriedadesFaixa
  FaixaDestaque -[hidden]right- PropriedadesFaixa
}

package "Mensagem destacada" as MSG #E8F4EA {
  interface MensagemDestacada <<Component>>
  class MensagemBase <<ConcreteComponent>>
  abstract class MensagemDecorator <<Decorator>>
  class ComFaixaCor <<ConcreteDecorator>>
  class ComFixacao <<ConcreteDecorator>>
  class ComLimiteCaracteres <<ConcreteDecorator>>

  MensagemDestacada <|.. MensagemBase
  MensagemDestacada <|.. MensagemDecorator
  MensagemDecorator o--> MensagemDestacada
  MensagemDecorator <|-- ComFaixaCor
  MensagemDecorator <|-- ComFixacao
  MensagemDecorator <|-- ComLimiteCaracteres
}

Chat ..> MensagemDestacada : <<cria e usa>>
DOM -[hidden]right- MSG
Chat -[hidden]right- MensagemDestacada

package "2. Catálogo, preço e pagamento" as INT {
  package "Catálogo" as CAT #EDE7F6 {
    class catalogo <<módulo>>
    class Pacote <<dataType>>
    class ConfiguracaoPreco <<dataType>>
    catalogo --> Pacote
    catalogo --> ConfiguracaoPreco
  }
  package "Preço" as PRC #E8F4EA {
    interface Preco <<Component>>
    abstract class PrecoDecorator <<Decorator>>
    Preco <|.. PrecoDecorator
    PrecoDecorator o--> Preco
  }
  package "Gateway de pagamento" as GW #FFF4E0 {
    interface GatewayPagamento <<Target>>
  }
  package "Confirmação" as CFM #E3EEFC {
    interface ConfirmadorPagamento <<Subject>>
    class ProxyConfirmacaoSegura <<Proxy>>
    class ServicoConfirmacao <<RealSubject>>
    ConfirmadorPagamento <|.. ProxyConfirmacaoSegura
    ConfirmadorPagamento <|.. ServicoConfirmacao
    ProxyConfirmacaoSegura --> ServicoConfirmacao : real
  }
  package "Financeiro" as FIN {
    class ServicoFinanceiro <<Colleague>>
    note bottom of ServicoFinanceiro
      consulta saldo no dominio
    end note
  }

  Pacote -[hidden]right- Preco
  GatewayPagamento -[hidden]right- ConfirmadorPagamento
  ConfirmadorPagamento -[hidden]right- ServicoFinanceiro
  Pacote -[hidden]down- GatewayPagamento
  Preco -[hidden]down- ConfirmadorPagamento

  ServicoConfirmacao -right-> ServicoFinanceiro : creditar
}

package "3. Aplicação" as APL {
  package "Recarga" as REC {
    class ServicoRecarga <<control>>
  }
  package "Doação" as DOA #FCE4EC {
    class ServicoDoacao <<Facade>>
    class MediatorDoacao <<Mediator>>
    class MediatorDoacaoComMensagem <<Mediator>>
    interface NotificadorChat <<contrato>>
    interface DoacaoNotificada <<contrato>>

    MediatorDoacao -[hidden]right- MediatorDoacaoComMensagem
    ServicoDoacao -[hidden]down- MediatorDoacao
    ServicoDoacao -[hidden]down- MediatorDoacaoComMensagem
    MediatorDoacaoComMensagem -[hidden]down- NotificadorChat
    NotificadorChat -[hidden]right- DoacaoNotificada

    ServicoDoacao -down-> MediatorDoacao
    ServicoDoacao -down-> MediatorDoacaoComMensagem
    MediatorDoacaoComMensagem -down-> NotificadorChat : <<chama>>
    NotificadorChat ..> DoacaoNotificada
  }
  ServicoRecarga -[hidden]right- ServicoDoacao
}

package "4. Apresentação" as APR {
  class RecargaController <<Client>>
  class DoacaoController <<Client>>
  RecargaController -[hidden]right- DoacaoController
}

Recarga -[hidden]down- Pacote
Doacao -[hidden]down- Preco
Saque -[hidden]down- GatewayPagamento
Carteira -[hidden]down- ServicoFinanceiro
MensagemDestacada -[hidden]down- Preco
Pacote -[hidden]down- ServicoRecarga
GatewayPagamento -[hidden]down- ServicoDoacao
ServicoRecarga -[hidden]down- RecargaController
ServicoDoacao -[hidden]down- DoacaoController

RecargaController -up-> ServicoRecarga
DoacaoController -up-> ServicoDoacao

Chat ..|> NotificadorChat
Doacao ..> catalogo : <<usa>>

@enduml
