# Copie para .env (ignorado pelo git) e preencha com credenciais de TESTE.
# Nunca use credenciais de produção: os demos as recusam, a menos que PERMITIR_PRODUCAO=1.

# Mercado Pago: access token de produção do usuário VENDEDOR de teste (APP_USR-...)
# ou credencial de teste da aplicação (TEST-...).
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=segredo-local-mp

# Stripe: chave secreta do modo de teste (sk_test_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=segredo-local-stripe
